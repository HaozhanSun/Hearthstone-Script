<?xml version="1.0" encoding="UTF-8"?>

<?import club.xiaojiawei.controls.ico.*?>
<?import club.xiaojiawei.controls.NotificationManager?>
<?import club.xiaojiawei.factory.NotificationFactory?>
<?import club.xiaojiawei.hsscript.component.svg.StatisticsIco?>
<?import javafx.scene.control.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.util.Duration?>
<?import java.lang.Double?>
<?import club.xiaojiawei.hsscript.component.TipNode?>
<?import club.xiaojiawei.hsscript.component.ConfigCheckBox?>
<StackPane xmlns:fx="http://javafx.com/fxml"
           minWidth="280.0" prefWidth="300.0"
           stylesheets="@css/main.css"
           fx:id="rootPane"
           fx:controller="club.xiaojiawei.hsscript.controller.javafx.MainController">
    <fx:define>
        <ToggleGroup fx:id="pauseToggleGroup"/>
    </fx:define>
    <Accordion fx:id="accordion" minWidth="0" styleClass="accordion-ui, accordion-ui-big, accordion-ui-pure"
               expandedPane="$titledPaneControl">
        <panes>
            <TitledPane text="控制" fx:id="titledPaneControl">
                <!-- Keep the narrow overlay width, but reclaim vertical space for the schedule preview. -->
                <VBox alignment="TOP_CENTER" fillWidth="true" spacing="10" minWidth="0" style="-fx-padding: 5 5 10 5">
                    <HBox alignment="CENTER" spacing="16" maxWidth="Infinity">
                        <ToggleButton fx:id="startButton" toggleGroup="$pauseToggleGroup" text="开始" onAction="#start"
                                      styleClass="btn-ui, btn-ui-small, btn-ui-success-3d">
                            <tooltip>
                                <Tooltip text="开始工作">
                                    <showDelay>
                                        <Duration millis="400"/>
                                    </showDelay>
                                </Tooltip>
                            </tooltip>
                            <graphic>
                                <StartIco fx:id="startIco"/>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="pauseButton" toggleGroup="$pauseToggleGroup" selected="true" text="暂停"
                                      onAction="#pause"
                                      styleClass="btn-ui, btn-ui-small, btn-ui-error-3d, btnPressed">
                            <tooltip>
                                <Tooltip text="暂停工作">
                                    <showDelay>
                                        <Duration millis="400"/>
                                    </showDelay>
                                </Tooltip>
                            </tooltip>
                            <graphic>
                                <PauseIco fx:id="pauseIco" color="gray"/>
                            </graphic>
                        </ToggleButton>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="6" maxWidth="Infinity">
                        <Label text="模式：" minWidth="40"/>
                        <ComboBox fx:id="runModeBox" prefWidth="110" minWidth="0" maxWidth="Infinity"
                                  HBox.hgrow="ALWAYS" styleClass="combo-box-ui, combo-box-ui-small, combo-box-ui-normal"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="6" maxWidth="Infinity">
                        <Label text="策略：" minWidth="40"/>
                        <ComboBox fx:id="deckStrategyBox" prefWidth="110" minWidth="0" maxWidth="Infinity"
                                  HBox.hgrow="ALWAYS" styleClass="combo-box-ui, combo-box-ui-small, combo-box-ui-normal"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="6" maxWidth="Infinity">
                        <Label text="默认槽位：" minWidth="65"/>
                        <ComboBox fx:id="defaultDeckSlotBox" prefWidth="64" minWidth="64"
                                  styleClass="combo-box-ui, combo-box-ui-small, combo-box-ui-normal"/>
                        <Button fx:id="saveDefaultDeckSlotBtn" text="保存为默认策略-卡组槽位绑定"
                                onAction="#saveDefaultDeckSlotBinding"
                                styleClass="btn-ui, btn-ui-small, btn-ui-normal"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>

                    <ConfigCheckBox text="打开时自动开始" styleClass="check-box-ui, check-box-ui-success"
                                    contentDisplay="RIGHT" config="START_ON_OPEN">
                        <graphic>
                            <TipNode text="关闭时只打开界面，不会自动开始脚本；E2E 启动参数仍可显式自动开始"/>
                        </graphic>
                    </ConfigCheckBox>

                    <HBox alignment="CENTER" spacing="6">
                        <ConfigCheckBox fx:id="debugRunModeCheckBox" text="调试/Test Run"
                                        styleClass="check-box-ui, check-box-ui-success"
                                        contentDisplay="RIGHT" config="DEBUG_RUN_MODE"
                                        onAction="#toggleDebugRun">
                            <tooltip>
                                <Tooltip text="启动后默认开启一次，最多运行30分钟；到期或手动关闭后恢复正常时间表"/>
                            </tooltip>
                        </ConfigCheckBox>
                        <Label fx:id="debugRunStatus" text="DISABLED" style="-fx-font-size: 10px;"/>
                    </HBox>

                    <GridPane>
                        <fx:define>
                            <Double fx:id="dataRowHeight" fx:value="25"/>
                        </fx:define>
                        <columnConstraints>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="CENTER" hgrow="NEVER"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints prefHeight="${dataRowHeight}" vgrow="NEVER" valignment="CENTER"/>
                            <RowConstraints prefHeight="${dataRowHeight}" vgrow="NEVER" valignment="CENTER"/>
                        </rowConstraints>

                        <Label GridPane.rowIndex="0" GridPane.columnIndex="0"
                               text="实战局数（未投降）："
                               contentDisplay="RIGHT">
                            <tooltip>
                                <Tooltip text="已完成且未记录为我方主动投降的对局；结算日志中的总第 N 局包含全部结束对局。"/>
                            </tooltip>
                            <graphic>
                                <Text text="0" fx:id="gameCount"/>
                            </graphic>
                        </Label>

                        <Label GridPane.rowIndex="0" GridPane.columnIndex="1"
                               text="胜率："
                               contentDisplay="RIGHT">
                            <graphic>
                                <Text text="?" fx:id="winningPercentage"/>
                            </graphic>
                        </Label>

                        <Label GridPane.rowIndex="1" GridPane.columnIndex="0"
                               text="游戏时长："
                               contentDisplay="RIGHT">
                            <graphic>
                                <Text text="0" fx:id="gameTime"/>
                            </graphic>
                        </Label>

                        <Label GridPane.rowIndex="1" GridPane.columnIndex="1"
                               text="经验："
                               contentDisplay="RIGHT">
                            <tooltip>
                                <Tooltip text="预估值"/>
                            </tooltip>
                            <graphic>
                                <Text text="0" fx:id="exp"/>
                            </graphic>
                        </Label>

                        <Group GridPane.rowIndex="0" GridPane.rowSpan="2" GridPane.columnIndex="2">
                            <ClearIco styleClass="resetDataIcon" onMouseClicked="#resetStatistics"/>
                        </Group>
                    </GridPane>

                    <VBox styleClass="workTimeVBox" VBox.vgrow="ALWAYS" alignment="CENTER"
                          minHeight="180.0" prefHeight="180.0">
                        <HBox alignment="CENTER" style="-fx-padding: 5 0 5 0">
                            <Label fx:id="workTimeRuleSetId"/>
                        </HBox>
                        <ScrollPane styleClass="scroll-pane-item" style="-fx-background: #E8E8FF" VBox.vgrow="ALWAYS" fitToHeight="true" fitToWidth="true" minWidth="0">
                            <VBox fx:id="workTimePane" spacing="5" alignment="CENTER" minWidth="0"/>
                        </ScrollPane>
                        <HBox alignment="CENTER" style="-fx-padding: 5;-fx-spacing: 20.0">
                            <ConfigCheckBox text="高优先" styleClass="check-box-ui, check-box-ui-success" contentDisplay="RIGHT" config="WORK_TIME_RULE_HIGH_PRIORITY">
                                <graphic>
                                    <TipNode text="模式和策略以时间规则为准；启用时间规则的卡组位按当前时段选择"/>
                                </graphic>
                            </ConfigCheckBox>
                            <Button styleClass="btn-ui, btn-ui-small, btn-ui-normal" onAction="#editWorkTime">
                                <graphic>
                                    <EditIco/>
                                </graphic>
                            </Button>
                        </HBox>
                    </VBox>

                    <VBox alignment="CENTER" spacing="5">
                        <HBox spacing="5" alignment="CENTER" maxWidth="Infinity">
                            <!-- 225px leaves room for the update/check buttons at the 280px minimum window width. -->
                            <Text fx:id="versionText" wrappingWidth="225" textAlignment="LEFT"
                                  style="-fx-cursor: hand" onMouseClicked="#openVersionMsg"/>
                            <Button onAction="#updateVersion" fx:id="updateBtn"
                                    styleClass="btn-ui, btn-ui-small, btn-ui-normal" visible="false" managed="false">
                                <tooltip>
                                    <Tooltip text="下载更新"/>
                                </tooltip>
                                <graphic>
                                    <UpdateIco/>
                                </graphic>
                            </Button>
                            <Button onAction="#flushVersion" fx:id="flushBtn"
                                    styleClass="btn-ui, btn-ui-small, btn-ui-normal">
                                <tooltip>
                                    <Tooltip text="检查更新"/>
                                </tooltip>
                                <graphic>
                                    <FlushIco fx:id="flushIco"/>
                                </graphic>
                            </Button>
                        </HBox>
                        <ProgressBar fx:id="downloadProgress" styleClass="progress-bar-ui" prefHeight="4"
                                     prefWidth="${titledPaneControl.width}" visible="false" managed="false"/>
                    </VBox>

                    <HBox alignment="CENTER">
                        <Button onAction="#openSettings" text="设置" styleClass="btn-ui, btn-ui-small">
                            <graphic>
                                <SettingsIco/>
                            </graphic>
                        </Button>
                        <HBox HBox.hgrow="ALWAYS" maxWidth="30"/>
                        <Button onAction="#openStatistics" text="统计" styleClass="btn-ui, btn-ui-small">
                            <graphic>
                                <StatisticsIco/>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
            </TitledPane>
            <TitledPane text="日志" fx:id="titledPaneLog">
                <VBox minWidth="0" fillWidth="true" spacing="5">
                    <GridPane fx:id="logStatisticsPane" minWidth="0" maxWidth="Infinity"
                              hgap="6" vgap="2" style="-fx-padding: 2 5 2 5;">
                        <columnConstraints>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints prefHeight="24" vgrow="NEVER"/>
                            <RowConstraints prefHeight="24" vgrow="NEVER"/>
                        </rowConstraints>
                        <Label GridPane.rowIndex="0" GridPane.columnIndex="0"
                               text="实战局数（未投降）：" contentDisplay="RIGHT">
                            <tooltip>
                                <Tooltip text="已完成且未记录为我方主动投降的对局；结算日志中的总第 N 局包含全部结束对局。"/>
                            </tooltip>
                            <graphic>
                                <Text text="0" fx:id="logGameCount"/>
                            </graphic>
                        </Label>
                        <Label GridPane.rowIndex="0" GridPane.columnIndex="1"
                               text="胜率：" contentDisplay="RIGHT">
                            <graphic>
                                <Text text="?" fx:id="logWinningPercentage"/>
                            </graphic>
                        </Label>
                        <Label GridPane.rowIndex="1" GridPane.columnIndex="0"
                               text="游戏时长：" contentDisplay="RIGHT">
                            <graphic>
                                <Text text="0" fx:id="logGameTime"/>
                            </graphic>
                        </Label>
                        <Label GridPane.rowIndex="1" GridPane.columnIndex="1"
                               text="经验：" contentDisplay="RIGHT">
                            <graphic>
                                <Text text="0" fx:id="logExp"/>
                            </graphic>
                        </Label>
                    </GridPane>
                    <Separator/>
                    <ScrollPane fx:id="logScrollPane" hbarPolicy="NEVER"
                                fitToWidth="true" VBox.vgrow="ALWAYS"
                                onMouseEntered="#mouseEnteredLog" onMouseExited="#mouseExitedLog"
                                onMouseClicked="#mouseClickedLog">
                        <VBox fillWidth="true" maxWidth="Infinity" minWidth="0" spacing="5" fx:id="logVBox"/>
                    </ScrollPane>
                </VBox>
            </TitledPane>
        </panes>
    </Accordion>
    <NotificationManager fx:id="notificationManger" notificationPos="BOTTOM_CENTER">
        <NotificationFactory showingCloseBtn="false" size="SMALL"/>
    </NotificationManager>
</StackPane>
